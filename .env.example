# Copy to .env and fill in your values.
# Never commit .env or share api_key in URLs.

MAPID_API_KEY=your_api_key_here
MAPID_PROJECT_ID=your_project_id_here
MAPID_LAYER_ID=your_layer_id_here
# Optional: pick layer by name instead of id (case-insensitive)
# MAPID_LAYER_NAME=sample_response
MAPID_BASE_URL=https://geoserver.mapid.io
# Optional: override if MAPID documents a different feature endpoint
# MAPID_FEATURES_ENDPOINT=get_layer_data_list

# Legacy placeholder names (still read as fallback by mapid_client.py)
# MAPID_API_TOKEN=your_api_key_here
